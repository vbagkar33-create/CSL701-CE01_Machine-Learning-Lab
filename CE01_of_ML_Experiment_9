        "    for col in df.columns\n",
        "]\n",
        "\n",
        "# Find the correct column names\n",
        "def find_column(candidates):\n",
        "    for name in candidates:\n",
        "        if name in df.columns:\n",
        "            return name\n",
        "    raise ValueError(\n",
        "        f\"Required column not found. Available columns: {df.columns.tolist()}\"\n",
        "    )\n",
        "\n",
        "feature_columns = [\n",
        "    find_column([\"culmen_length_mm\", \"bill_length_mm\"]),\n",
        "    find_column([\"culmen_depth_mm\", \"bill_depth_mm\"]),\n",
        "    find_column([\"flipper_length_mm\"]),\n",
        "    find_column([\"body_mass_g\"])\n",
        "]\n",
        "\n",
        "target_column = find_column([\"species\"])\n",
        "\n",
        "# Keep selected features and target\n",
        "data = df[feature_columns + [target_column]].copy()\n",
        "\n",
        "# Convert feature columns to numeric values\n",
        "for col in feature_columns:\n",
        "    data[col] = pd.to_numeric(data[col], errors=\"coerce\")\n",
        "\n",
        "# Remove rows with missing target values\n",
        "data = data.dropna(subset=[target_column])\n",
        "\n",
        "# Fill missing numerical values with their median\n",
        "data[feature_columns] = data[feature_columns].fillna(\n",
        "    data[feature_columns].median()\n",
