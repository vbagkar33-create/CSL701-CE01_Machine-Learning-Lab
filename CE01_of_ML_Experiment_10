      "source": [
        "\n",
        "# Task 6: Analyze Results and Cluster Statistics\n",
        "\n",
        "# Create a results dataset\n",
        "results = df.copy()\n",
        "\n",
        "# Calculate cluster statistics\n",
        "cluster_stats = results.groupby(\"Cluster\").agg(\n",
        "    Customer_Count=(\"Cluster\", \"size\"),\n",
        "    Average_Age=(\"Age\", \"mean\"),\n",
        "    Average_Income=(\"Annual Income (k$)\", \"mean\"),\n",
        "    Average_Spending_Score=(\"Spending Score (1-100)\", \"mean\")\n",
        ").round(2)\n",
        "\n",
        "print(\"Cluster Statistics:\")\n",
        "display(cluster_stats)\n",
        "\n",
        "# Separate noise points\n",
        "noise_customers = results[results[\"Cluster\"] == -1]\n",
        "\n",
        "print(\"\\nNumber of noise customers:\", len(noise_customers))\n",
        "print(\"\\nNoise Customer Details:\")\n",
        "display(noise_customers.head(10))\n",
        "\n",
        "# Plot average income and spending score per cluster\n",
        "# Exclude noise from the cluster-average comparison\n",
        "cluster_means = (\n",
        "    results[results[\"Cluster\"] != -1]\n",
        "    .groupby(\"Cluster\")[\n",
        "        [\"Annual Income (k$)\", \"Spending Score (1-100)\"]\n",
        "    ]\n",
        "    .mean()\n",
        ")\n",
        "\n",
        "if not cluster_means.empty:\n",
        "    cluster_means.plot(\n",
        "        kind=\"bar\",\n",
        "        figsize=(10, 6)\n",
        "    )\n",
        "\n",
        "    plt.title(\"Average Income and Spending Score by Cluster\")\n",
        "    plt.xlabel(\"Cluster\")\n",
        "    plt.ylabel(\"Average Value\")\n",
        "    plt.xticks(rotation=0)\n",
        "    plt.legend(title=\"Features\")\n",
        "    plt.tight_layout()\n",
        "    plt.show()\n",
        "else:\n",
        "    print(\"No clusters found apart from noise. Adjust DBSCAN parameters.\")\n",
        "\n",
        "\n",
        "# Additional Bar Graph: Noise (-1), Cluster 0, and Cluster 1\n",
        "# Compare average income and average spending score\n",
        "\n",
        "selected_clusters = results[results[\"Cluster\"].isin([-1, 0, 1])]\n",
        "\n",
        "selected_means = (\n",
        "    selected_clusters\n",
        "    .groupby(\"Cluster\")[\n",
        "        [\"Annual Income (k$)\", \"Spending Score (1-100)\"]\n",
        "    ]\n",
        "    .mean()\n",
        "    .reindex([-1, 0, 1])\n",
        ")\n",
        "\n",
        "# Rename cluster labels for display\n",
        "selected_means.index = [\"Noise (-1)\", \"Cluster 0\", \"Cluster 1\"]\n",
        "\n",
        "# Plot grouped bar graph\n",
        "selected_means.plot(\n",
        "    kind=\"bar\",\n",
        "    figsize=(10, 6),\n",
        "    width=0.8\n",
        ")\n",
        "\n",
        "plt.title(\"Average Income and Spending Score: Noise, Cluster 0 and Cluster 1\")\n",
        "plt.xlabel(\"Cluster Label\")\n",
        "plt.ylabel(\"Average Value\")\n",
        "plt.xticks(rotation=0)\n",
        "plt.legend([\"Average Income\", \"Average Spending Score\"])\n",
        "plt.grid(axis=\"y\", linestyle=\"--\", alpha=0.4)\n",
        "plt.tight_layout()\n",
        "plt.show()\n"
