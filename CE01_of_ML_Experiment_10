        "\n",
        "# Task 5: Evaluate DBSCAN Clustering\n",
        "\n",
        "# Count clusters, excluding noise label -1\n",
        "unique_labels = set(cluster_labels)\n",
        "n_clusters = len(unique_labels - {-1})\n",
        "\n",
        "# Count noise points\n",
        "n_noise = np.sum(cluster_labels == -1)\n",
        "\n",
        "print(\"Number of clusters:\", n_clusters)\n",
        "print(\"Number of noise points:\", n_noise)\n",
        "print(\"Total data points:\", len(cluster_labels))\n",
        "print(\"Noise percentage:\",\n",
        "      round(n_noise / len(cluster_labels) * 100, 2), \"%\")\n",
        "\n",
        "# Calculate Silhouette Score for non-noise points\n",
        "non_noise_mask = cluster_labels != -1\n",
        "non_noise_labels = cluster_labels[non_noise_mask]\n",
        "non_noise_data = X_scaled[non_noise_mask]\n",
        "\n",
        "if (len(non_noise_labels) > 1 and\n",
        "        len(np.unique(non_noise_labels)) >= 2 and\n",
        "        len(np.unique(non_noise_labels)) < len(non_noise_labels)):\n",
        "\n",
        "    score = silhouette_score(non_noise_data, non_noise_labels)\n",
        "    print(\"Silhouette Score (excluding noise):\",\n",
        "          round(score, 4))\n",
        "else:\n",
        "    print(\"Silhouette Score cannot be calculated.\")\n",
        "    print(\"Try adjusting eps or min_samples.\")\n",
        "\n",
        "# Display number of points in each cluster\n",
        "print(\"\\nPoints per cluster (-1 represents noise):\")\n",
